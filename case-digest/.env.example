# Clio region base URL (US default). EU: https://eu.app.clio.com  CA: https://ca.app.clio.com  AU: https://au.app.clio.com
CLIO_BASE_URL=https://app.clio.com

# Option A: OAuth app credentials (run `python -m backend.auth` once to get a token)
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8765/callback

# Option B: paste an access token directly (skips OAuth)
CLIO_ACCESS_TOKEN=

# AI provider (used by the digest step, not by ingest)
ANTHROPIC_API_KEY=
