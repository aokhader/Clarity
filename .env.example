# Copy to .env and fill in. Never commit .env.

# Clio Manage (developer application with read-only permissions)
CLIO_BASE_URL=https://app.clio.com
# Pinned API minor version, sent as X-API-VERSION (see docs/clio-api.md)
CLIO_API_VERSION=4.0.13
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
# Search string used to find the matter. Change it to run on a different matter.
CLIO_MATTER_QUERY=Sapini

# Models
# anthropic (Messages API) or openai (Chat Completions)
LLM_PROVIDER=anthropic
# Optional: leave blank for the provider's public endpoint
LLM_BASE_URL=
LLM_API_KEY=
# Vision-capable model for per-page and per-record extraction
EXTRACT_MODEL=
# Stronger model for mapping, scoring, and the brief
MERGE_MODEL=
# Prices in USD per million tokens, used for the cost-per-case figure
EXTRACT_PRICE_IN=
EXTRACT_PRICE_OUT=
MERGE_PRICE_IN=
MERGE_PRICE_OUT=
EXTRACT_CONCURRENCY=8

# Storage. A relative path resolves against the repository root.
# Holds app.db, downloaded files, and rendered pages.
DATA_DIR=./data

# App
FRONTEND_ORIGIN=http://localhost:5173
SHARE_DEFAULT_EXPIRY_DAYS=30
